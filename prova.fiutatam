                <!-- Pads Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 pt-2">
                    <!-- Pad 1: Rullante -->
                    <button onclick="playDrumSound('snare')" class="p-4 bg-slate-800 hover:bg-slate-700 active:scale-95 text-white rounded-xl shadow flex flex-col items-center justify-center space-y-2 transition-transform">
                        <span class="text-2xl">🥁</span>
